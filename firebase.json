{
  "hosting": {
    "public": "site",
    "ignore": ["firebase.json", "**/.*"],
    "headers": [
      { "source": "/version.json", "headers": [{ "key": "Cache-Control", "value": "no-store" }] },
      { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/index.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "**/*.apk", "headers": [{ "key": "Content-Type", "value": "application/vnd.android.package-archive" }, { "key": "Content-Disposition", "value": "attachment; filename=\"Beza Youth.apk\"" }] }
    ]
  }
}
