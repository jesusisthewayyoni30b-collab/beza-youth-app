rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function isLeader() { return signedIn() && exists(/databases/$(database)/documents/leaders/$(request.auth.uid)); }
    function isOwner() { return signedIn() && exists(/databases/$(database)/documents/owners/$(request.auth.uid)); }

    // each member's profile + progress: everyone on the team can read, only you can write yours
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && me() == uid;
    }

    // leaders: you become a leader only by entering the secret leader code
    match /leaders/{uid} {
      allow read: if signedIn() && (me() == uid || isLeader());
      allow create: if signedIn() && me() == uid
        && request.resource.data.code == get(/databases/$(database)/documents/secret/leaderCode).data.code;
      allow delete: if isLeader();
    }
    match /secret/{d} { allow read, write: if false; }

    // chat groups (leaders manage) and their messages
    match /groups/{gid} {
      allow read: if signedIn();
      allow create: if isLeader() || (signedIn() && gid in ['all', 'singers', 'musicians', 'sound', 'leaders']);
      allow update, delete: if isLeader();
      match /messages/{mid} {
        function grp() { return get(/databases/$(database)/documents/groups/$(gid)).data; }
        function canSee() { return grp().get('leadersOnly', false) != true || isLeader(); }
        allow read: if signedIn() && canSee();
        allow create: if signedIn() && canSee() && request.resource.data.uid == me()
          && (grp().get('announce', false) != true || isLeader());
        allow update: if signedIn() && canSee() && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['react']) || (resource.data.uid == me() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'edited', 'react'])));
        allow delete: if isLeader() || (signedIn() && resource.data.uid == me());
      }
      // who has seen which messages (for 'Seen by')
      match /reads/{u} {
        allow read: if signedIn();
        allow write: if signedIn() && u == me();
      }
    }

    // songs & chord charts: the whole team can add and fix; leaders or the author can delete
    match /songs/{sid} {
      allow read, create, update: if signedIn();
      allow delete: if isLeader() || (signedIn() && resource.data.uid == me());
    }

    // team calendar: everyone sees, leaders post
    match /events/{eid} {
      allow read: if signedIn();
      allow write: if isLeader();
    }

    // team feed: leaders post
    match /feed/{fid} {
      allow read: if signedIn();
      allow write: if isLeader();
    }

    // help & feedback: anyone signed in can send, only leaders read
    match /feedback/{fid} {
      allow create: if signedIn() && request.resource.data.uid == me();
      allow read: if isLeader() || isOwner();
      allow update, delete: if isLeader();
    }

    // learning questions from the 'Ask a leader' button: members ask, leaders answer
    match /questions/{qid} {
      allow create: if signedIn() && request.resource.data.uid == me();
      allow read: if isLeader() || isOwner() || (signedIn() && resource.data.uid == me());
      allow update: if isLeader() || (signedIn() && resource.data.uid == me() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seen']));
      allow delete: if isLeader();
    }

    // assignments: leaders send, members see and complete their own
    match /assignments/{aid} {
      allow read: if isLeader() || (signedIn() && resource.data.toUid == me());
      allow create: if isLeader() || (signedIn() && request.resource.data.toUid == me());
      allow update: if isLeader() || (signedIn() && resource.data.toUid == me());
      allow delete: if isLeader();
    }

    // hidden owner flag: only the owner can see their own doc; nobody can write it from the app
    match /owners/{uid} {
      allow read: if signedIn() && me() == uid;
      allow write: if false;
    }

    // Rehearsal Room song folders (split parts). Anyone can share; no duplicates (create only if new); leaders/owner delete
    match /stems/{sid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.by == me();
      allow update: if isLeader() || isOwner() || (signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['extras']));
      allow delete: if isLeader() || isOwner();
    }
    // the audio itself, in pieces
    match /stemdata/{cid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.h is string;
      allow update: if signedIn() && resource.data.h == request.resource.data.h && !exists(/databases/$(database)/documents/stems/$(resource.data.h));
      allow delete: if isLeader() || isOwner();
    }
  }
}
